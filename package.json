{
  "name": "relaypm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @relaypm/api dev\" \"pnpm --filter @relaypm/web dev\"",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run packages/core/test packages/db/test packages/keewano/src/index.test.ts packages/agentic/src/index.test.ts",
    "test:integration": "vitest run apps/api/src/app.test.ts packages/dial/src/webhook.test.ts",
    "test:eval": "vitest run packages/evals/test --reporter=default --reporter=junit --outputFile.junit=eval-results.xml",
    "test:dial:smoke": "tsx scripts/dial-smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@keewano/codegen": "1.1.0-111",
    "@types/node": "^24.8.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@keewano/node-sdk": "1.3.0-207"
  }
}
