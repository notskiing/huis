# Huis backend
NODE_ENV=development
DATABASE_URL=file:./.data/huis.db
MONGODB_URI=
MONGODB_DATABASE=huis
MONGODB_COLLECTION_PREFIX=huis_
APP_BASE_URL=http://localhost:3001
APPROVAL_SIGNING_SECRET=replace-with-a-long-random-value
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
LOG_REDACTION_SALT=replace-with-a-long-random-value
TENANT_INTAKE_EMAIL=maintenance@your-domain.com

# Dial — live calls/texts stay disabled until configured and allowlisted
DIAL_API_KEY=
DIAL_API_URL=https://api.getdial.ai
DIAL_PHONE_NUMBER_ID=
DIAL_WEBHOOK_SECRET=
DIAL_ALLOWLIST_E164=+14155550123
LANDLORD_ESCALATION_PHONE_E164=+14155550123
LIVE_DIAL_TEST=0

# Keewano is the live maintenance timeline. Keep the local outbox as a safe fallback.
KEEWANO_ENABLED=true
KEEWANO_PROJECT_API_KEY=
KEEWANO_DATA_DIR=.data/keewano
KEEWANO_ENDPOINT=

# Sparta remains deferred.
SPARTA_ENABLED=false
EVAL_MODE=0
