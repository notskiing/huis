# Core application
NODE_ENV=development
DATABASE_URL=file:./.data/relaypm.db
APP_BASE_URL=https://YOUR_PUBLIC_HOST
APPROVAL_SIGNING_SECRET=replace-with-a-long-random-value
LOG_REDACTION_SALT=replace-with-a-long-random-value
DEMO_PROPERTY_TIMEZONE=America/Los_Angeles

# Dial — required for the live sponsor demo
DIAL_API_KEY=
DIAL_API_URL=https://api.getdial.ai
DIAL_PHONE_NUMBER_ID=pn_replace_me
DIAL_WEBHOOK_SECRET=whsec_replace_me
DIAL_ALLOWLIST_E164=+14155550123
LANDLORD_ESCALATION_PHONE_E164=+14155550123
LIVE_DIAL_TEST=0

# Keewano — optional analytics
KEEWANO_ENABLED=false
KEEWANO_PROJECT_API_KEY=
KEEWANO_DATA_DIR=.data/keewano

# Sparta — optional, test-only
SPARTA_ENABLED=false
EVAL_MODE=0

# Do not add WORLDS_TASK_JSON or WORLDS_* connection values here.
# Sparta injects fresh values for each evaluation run.
